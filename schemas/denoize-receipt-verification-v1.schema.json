{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-receipt-verification-v1.schema.json",
  "title": "denoize successful offline receipt verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "receipt_schema",
    "key_id",
    "plan_digest",
    "kind",
    "verified_items"
  ],
  "properties": {
    "schema": { "const": "denoize-receipt-verification-v1" },
    "schema_version": { "const": 1 },
    "receipt_schema": { "const": "denoize-execution-receipt-v1" },
    "key_id": { "$ref": "#/$defs/keyId" },
    "plan_digest": { "$ref": "#/$defs/digest" },
    "kind": { "enum": ["file", "batch"] },
    "verified_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\\\:\\u0000-\\u001F\\u007F-\\u009F])[^/]{1,255}(?:/[^/]{1,255})*$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["len", "digest"],
      "properties": {
        "len": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "output_path", "output", "outcome"],
      "properties": {
        "item_id": { "$ref": "#/$defs/digest" },
        "output_path": { "$ref": "#/$defs/locator" },
        "output": { "$ref": "#/$defs/fingerprint" },
        "outcome": { "enum": ["succeeded", "skipped"] }
      }
    }
  }
}

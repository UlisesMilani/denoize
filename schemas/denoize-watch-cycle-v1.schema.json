{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/schemas/denoize-watch-cycle-v1.schema.json",
  "title": "denoize watch-folder cycle report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "input",
    "output",
    "cancelled",
    "observed",
    "pending",
    "attempted",
    "succeeded",
    "retrying",
    "quarantined",
    "superseded",
    "scan_errors"
  ],
  "properties": {
    "schema": { "const": "denoize-watch-cycle-v1" },
    "schema_version": { "const": 1 },
    "input": { "type": "string" },
    "output": { "type": "string" },
    "cancelled": { "type": "boolean" },
    "observed": { "type": "integer", "minimum": 0 },
    "pending": { "type": "integer", "minimum": 0 },
    "attempted": { "type": "integer", "minimum": 0 },
    "succeeded": { "type": "integer", "minimum": 0 },
    "retrying": { "type": "integer", "minimum": 0 },
    "quarantined": { "type": "integer", "minimum": 0 },
    "superseded": { "type": "integer", "minimum": 0 },
    "scan_errors": { "type": "integer", "minimum": 0 }
  }
}

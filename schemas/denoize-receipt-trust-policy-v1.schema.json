{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-receipt-trust-policy-v1.schema.json",
  "title": "denoize receipt trust and revocation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "trusted_keys", "revoked_key_ids"],
  "properties": {
    "schema": { "const": "denoize-receipt-trust-policy-v1" },
    "schema_version": { "const": 1 },
    "trusted_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/publicKey" }
    },
    "revoked_key_ids": {
      "type": "array",
      "maxItems": 65536,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/keyId" }
    }
  },
  "$defs": {
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "algorithm",
        "key_id",
        "public_key_base64"
      ],
      "properties": {
        "schema": { "const": "denoize-receipt-public-key-v1" },
        "schema_version": { "const": 1 },
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/keyId" },
        "public_key_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      }
    }
  }
}

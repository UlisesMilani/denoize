{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/schemas/denoize-meeting-speaker-promotion-evidence-v1.schema.json",
  "title": "denoize signed meeting-speaker promotion evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "payload", "signature"],
  "properties": {
    "schema": { "const": "denoize-meeting-speaker-promotion-evidence-v1" },
    "schema_version": { "const": 1 },
    "payload": { "$ref": "#/$defs/payload" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,256}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_at_unix_seconds",
        "model_package_sha256",
        "source_revision",
        "source_sha256",
        "checkpoint_sha256",
        "configuration_sha256",
        "corpus_manifest_sha256",
        "corpus_license_manifest_sha256",
        "evaluation_result_sha256",
        "listening_result_sha256",
        "strata",
        "real_meeting_cases",
        "distinct_speakers",
        "language_count",
        "speaker_count_expected_calibration_error",
        "listener_count",
        "listener_preference",
        "retained_enrollment_recordings",
        "retained_speaker_embeddings",
        "accepted"
      ],
      "properties": {
        "completed_at_unix_seconds": { "$ref": "#/$defs/count" },
        "model_package_sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "$ref": "#/$defs/id" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "corpus_license_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "evaluation_result_sha256": { "$ref": "#/$defs/sha256" },
        "listening_result_sha256": { "$ref": "#/$defs/sha256" },
        "strata": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stratum" }
        },
        "real_meeting_cases": { "type": "integer", "minimum": 100, "maximum": 1000000 },
        "distinct_speakers": { "type": "integer", "minimum": 100, "maximum": 1000000 },
        "language_count": { "type": "integer", "minimum": 2, "maximum": 1000 },
        "speaker_count_expected_calibration_error": { "type": "number", "minimum": 0, "maximum": 0.05 },
        "listener_count": { "type": "integer", "minimum": 20, "maximum": 100000 },
        "listener_preference": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "retained_enrollment_recordings": { "const": 0 },
        "retained_speaker_embeddings": { "const": 0 },
        "accepted": { "type": "boolean" }
      }
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cases",
        "permutation_si_sdr_improvement_db",
        "diarization_error_rate",
        "jaccard_error_rate",
        "overlap_f1",
        "track_swap_rate",
        "tcp_wer_regression",
        "unknown_false_assignment_rate",
        "non_finite_samples",
        "passed"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "cases": { "type": "integer", "minimum": 10, "maximum": 1000000 },
        "permutation_si_sdr_improvement_db": { "type": "number", "minimum": -240, "maximum": 240 },
        "diarization_error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "jaccard_error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "overlap_f1": { "type": "number", "minimum": 0, "maximum": 1 },
        "track_swap_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "tcp_wer_regression": { "type": "number", "minimum": -1, "maximum": 1 },
        "unknown_false_assignment_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "non_finite_samples": { "$ref": "#/$defs/count" },
        "passed": { "type": "boolean" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value_base64"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/sha256" },
        "value_base64": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/schemas/denoize-meeting-speaker-report-v1.schema.json",
  "title": "denoize anonymous meeting speaker-track report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "denoize_version",
    "configuration_sha256",
    "network_accessed",
    "deterministic",
    "model",
    "promotion_evidence",
    "source_sample_rate",
    "source_channels",
    "source_frames",
    "model_sample_rate",
    "model_input_channels",
    "model_window_samples",
    "model_hop_samples",
    "model_activity_frames",
    "model_windows",
    "maximum_tracks",
    "published_tracks",
    "track_summaries",
    "unknown_regions",
    "overlap_regions",
    "permutation_ambiguous_windows",
    "mixture_pcm_sha256",
    "unassigned_pcm_sha256",
    "recombination_maximum_absolute_error",
    "exact_output_duration",
    "raw_enrollment_retained",
    "speaker_embeddings_retained",
    "path_fields_recorded",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "denoize-meeting-speaker-report-v1" },
    "schema_version": { "const": 1 },
    "denoize_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "network_accessed": { "const": false },
    "deterministic": { "const": true },
    "model": { "$ref": "#/$defs/model" },
    "promotion_evidence": { "$ref": "#/$defs/evidence" },
    "source_sample_rate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
    "source_channels": { "type": "integer", "minimum": 1, "maximum": 64 },
    "source_frames": { "type": "integer", "minimum": 1, "maximum": 345600000 },
    "model_sample_rate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
    "model_input_channels": { "type": "integer", "minimum": 1, "maximum": 64 },
    "model_window_samples": { "type": "integer", "minimum": 256, "maximum": 16777216 },
    "model_hop_samples": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "model_activity_frames": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "model_windows": { "type": "integer", "minimum": 1, "maximum": 250000 },
    "maximum_tracks": { "type": "integer", "minimum": 1, "maximum": 8 },
    "published_tracks": { "type": "integer", "minimum": 1, "maximum": 8 },
    "track_summaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/track" }
    },
    "unknown_regions": {
      "type": "array",
      "maxItems": 250000,
      "items": { "$ref": "#/$defs/region" }
    },
    "overlap_regions": {
      "type": "array",
      "maxItems": 250000,
      "items": { "$ref": "#/$defs/region" }
    },
    "permutation_ambiguous_windows": { "$ref": "#/$defs/count" },
    "mixture_pcm_sha256": { "$ref": "#/$defs/sha256" },
    "unassigned_pcm_sha256": { "$ref": "#/$defs/sha256" },
    "recombination_maximum_absolute_error": { "type": "number", "minimum": 0, "maximum": 1e-12 },
    "exact_output_duration": { "const": true },
    "raw_enrollment_retained": { "const": false },
    "speaker_embeddings_retained": { "const": false },
    "path_fields_recorded": { "const": 0 },
    "limitations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_sha256",
        "public_key_sha256",
        "package_id",
        "package_revision",
        "precision_profile",
        "source_revision",
        "source_sha256",
        "source_license_spdx",
        "checkpoint_sha256",
        "checkpoint_license_spdx",
        "accelerator"
      ],
      "properties": {
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "public_key_sha256": { "$ref": "#/$defs/sha256" },
        "package_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "package_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "precision_profile": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_revision": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "source_license_spdx": { "type": "string", "minLength": 1, "maxLength": 512 },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_license_spdx": { "type": "string", "minLength": 1, "maxLength": 512 },
        "accelerator": { "enum": ["cpu", "metal", "cuda"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signing_key_id",
        "corpus_manifest_sha256",
        "corpus_license_manifest_sha256",
        "evaluation_result_sha256",
        "listening_result_sha256",
        "real_meeting_cases",
        "distinct_speakers",
        "languages",
        "accepted"
      ],
      "properties": {
        "signing_key_id": { "$ref": "#/$defs/sha256" },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "corpus_license_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "evaluation_result_sha256": { "$ref": "#/$defs/sha256" },
        "listening_result_sha256": { "$ref": "#/$defs/sha256" },
        "real_meeting_cases": { "type": "integer", "minimum": 100, "maximum": 1000000 },
        "distinct_speakers": { "type": "integer", "minimum": 100, "maximum": 1000000 },
        "languages": { "type": "integer", "minimum": 2, "maximum": 1000 },
        "accepted": { "const": true }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_sample", "end_sample", "state", "confidence", "overlap"],
      "properties": {
        "start_sample": { "$ref": "#/$defs/count" },
        "end_sample": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "state": { "enum": ["active", "uncertain"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "overlap": { "type": "boolean" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_sample", "end_sample", "confidence"],
      "properties": {
        "start_sample": { "$ref": "#/$defs/count" },
        "end_sample": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "pcm_sha256",
        "active_samples",
        "uncertain_samples",
        "segments",
        "consent_record_sha256",
        "target_speaker_report_sha256"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^speaker-00[1-8]$" },
        "label": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
        "pcm_sha256": { "$ref": "#/$defs/sha256" },
        "active_samples": { "$ref": "#/$defs/count" },
        "uncertain_samples": { "$ref": "#/$defs/count" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 250000,
          "items": { "$ref": "#/$defs/segment" }
        },
        "consent_record_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "target_speaker_report_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    }
  }
}

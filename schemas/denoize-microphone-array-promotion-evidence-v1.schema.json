{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/schemas/denoize-microphone-array-promotion-evidence-v1.schema.json",
  "title": "denoize signed microphone-array promotion evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "payload", "signature"],
  "properties": {
    "schema": { "const": "denoize-microphone-array-promotion-evidence-v1" },
    "schema_version": { "const": 1 },
    "payload": { "$ref": "#/$defs/payload" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,256}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_at_unix_seconds",
        "implementation",
        "implementation_source_revision",
        "implementation_source_sha256",
        "configuration_sha256",
        "corpus_manifest_sha256",
        "evaluation_result_sha256",
        "listening_result_sha256",
        "strata",
        "real_meeting_cases",
        "unseen_geometry_cases",
        "permutation_cases",
        "paced_realtime_blocks",
        "worst_case_realtime_factor",
        "callback_allocations",
        "callback_locks",
        "callback_waits",
        "deadline_misses",
        "listener_count",
        "listener_preference",
        "accepted"
      ],
      "properties": {
        "completed_at_unix_seconds": { "$ref": "#/$defs/count" },
        "implementation": { "const": "native-wpe-mask-mvdr-v1" },
        "implementation_source_revision": { "$ref": "#/$defs/id" },
        "implementation_source_sha256": { "$ref": "#/$defs/sha256" },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "evaluation_result_sha256": { "$ref": "#/$defs/sha256" },
        "listening_result_sha256": { "$ref": "#/$defs/sha256" },
        "strata": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stratum" }
        },
        "real_meeting_cases": { "type": "integer", "minimum": 100, "maximum": 1000000 },
        "unseen_geometry_cases": { "type": "integer", "minimum": 100, "maximum": 1000000 },
        "permutation_cases": { "type": "integer", "minimum": 100, "maximum": 1000000 },
        "paced_realtime_blocks": { "type": "integer", "minimum": 10000, "maximum": 9007199254740991 },
        "worst_case_realtime_factor": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "callback_allocations": { "const": 0 },
        "callback_locks": { "const": 0 },
        "callback_waits": { "const": 0 },
        "deadline_misses": { "const": 0 },
        "listener_count": { "type": "integer", "minimum": 20, "maximum": 100000 },
        "listener_preference": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "accepted": { "type": "boolean" }
      }
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cases",
        "si_sdr_improvement_db",
        "wer_regression",
        "doa_error_degrees",
        "reference_coloration_db",
        "target_leakage_db",
        "non_finite_samples",
        "passed"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "cases": { "type": "integer", "minimum": 10, "maximum": 1000000 },
        "si_sdr_improvement_db": { "type": "number", "minimum": -240, "maximum": 240 },
        "wer_regression": { "type": "number", "minimum": -1, "maximum": 1 },
        "doa_error_degrees": { "type": "number", "minimum": 0, "maximum": 180 },
        "reference_coloration_db": { "type": "number", "minimum": -240, "maximum": 240 },
        "target_leakage_db": { "type": "number", "minimum": -240, "maximum": 240 },
        "non_finite_samples": { "$ref": "#/$defs/count" },
        "passed": { "type": "boolean" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value_base64"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/sha256" },
        "value_base64": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}

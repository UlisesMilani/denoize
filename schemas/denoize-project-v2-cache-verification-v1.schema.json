{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-project-v2-cache-verification-v1.schema.json",
  "title": "denoize project v2 cache verification",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "key", "decision", "reason", "output"],
  "properties": { "schema": { "const": "denoize-project-v2-cache-verification-v1" }, "schema_version": { "const": 1 }, "key": { "$ref": "denoize-project-v2.schema.json#/$defs/digest" }, "decision": { "enum": ["hit", "miss"] }, "reason": { "$ref": "denoize-project-v2.schema.json#/$defs/text" }, "output": { "oneOf": [{ "$ref": "denoize-project-v2.schema.json#/$defs/fingerprint" }, { "type": "null" }] } }
}

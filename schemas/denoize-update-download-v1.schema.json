{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-update-download-v1.schema.json",
  "title": "denoize authenticated update bundle download report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "platform",
    "from_version",
    "candidate_version",
    "candidate_sequence",
    "manifest_sha256",
    "signing_key_id",
    "bundle_sha256",
    "size_bytes",
    "output_file_name",
    "outcome"
  ],
  "properties": {
    "schema": { "const": "denoize-update-download-v1" },
    "schema_version": { "const": 1 },
    "platform": { "$ref": "#/$defs/identifier" },
    "from_version": { "$ref": "#/$defs/version" },
    "candidate_version": { "$ref": "#/$defs/version" },
    "candidate_sequence": { "type": "integer", "minimum": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "signing_key_id": { "type": "string", "pattern": "^[0-9A-F]{16}$" },
    "bundle_sha256": { "$ref": "#/$defs/sha256" },
    "size_bytes": { "type": "integer", "minimum": 1, "maximum": 5368709120 },
    "output_file_name": { "$ref": "#/$defs/fileName" },
    "outcome": { "const": "downloaded-and-verified" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9._+-]{1,128}$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "not": { "pattern": "[\\\\/:]" }
    }
  }
}

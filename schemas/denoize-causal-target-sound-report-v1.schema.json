{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/schemas/denoize-causal-target-sound-report-v1.schema.json",
  "title": "denoize causal target-sound render report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "denoize_version", "network_accessed", "deterministic",
    "mode", "configuration_sha256", "query", "model", "promotion_evidence",
    "source_sample_rate", "source_channels", "source_frames", "model_sample_rate",
    "model_channels", "frame_samples", "algorithmic_latency_samples", "flush_samples",
    "input_blocks", "flush_blocks", "decision_counts", "presence_transitions",
    "source_clock_withheld_frames",
    "source_clock_conservative_fallback", "target_published", "residual_published",
    "output_published", "input_pcm_sha256", "target_pcm_sha256", "residual_pcm_sha256",
    "output_pcm_sha256", "maximum_model_recombination_error",
    "maximum_publication_recombination_error", "partial_semantic_removal_fallbacks",
    "path_fields_recorded", "limitations", "warnings"
  ],
  "properties": {
    "schema": { "const": "denoize-causal-target-sound-report-v1" },
    "schema_version": { "const": 1 },
    "denoize_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "network_accessed": { "const": false },
    "deterministic": { "const": true },
    "mode": { "enum": ["preserve", "remove"] },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "query": { "$ref": "#/$defs/query" },
    "model": { "$ref": "#/$defs/model" },
    "promotion_evidence": { "$ref": "#/$defs/evidence" },
    "source_sample_rate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
    "source_channels": { "type": "integer", "minimum": 1, "maximum": 2 },
    "source_frames": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "model_sample_rate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
    "model_channels": { "type": "integer", "minimum": 1, "maximum": 2 },
    "frame_samples": { "type": "integer", "minimum": 1, "maximum": 262144 },
    "algorithmic_latency_samples": { "type": "integer", "minimum": 0, "maximum": 262144 },
    "flush_samples": { "type": "integer", "minimum": 0, "maximum": 262144 },
    "input_blocks": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "flush_blocks": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "decision_counts": { "$ref": "#/$defs/decision_counts" },
    "presence_transitions": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "source_clock_withheld_frames": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "source_clock_conservative_fallback": { "type": "boolean" },
    "target_published": { "const": true },
    "residual_published": { "const": true },
    "output_published": { "const": true },
    "input_pcm_sha256": { "$ref": "#/$defs/sha256" },
    "target_pcm_sha256": { "$ref": "#/$defs/sha256" },
    "residual_pcm_sha256": { "$ref": "#/$defs/sha256" },
    "output_pcm_sha256": { "$ref": "#/$defs/sha256" },
    "maximum_model_recombination_error": { "type": "number", "minimum": 0, "maximum": 2 },
    "maximum_publication_recombination_error": { "type": "number", "minimum": 0, "maximum": 2 },
    "partial_semantic_removal_fallbacks": { "const": 0 },
    "path_fields_recorded": { "const": 0 },
    "limitations": {
      "type": "array", "minItems": 8, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "warnings": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9._+-]{1,256}$" },
    "counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_sha256", "catalog_sha256", "catalog_revision", "class_ids_sha256",
        "class_count", "class_id", "class_index", "canonical_label", "encoding",
        "open_text_accepted"
      ],
      "properties": {
        "query_sha256": { "$ref": "#/$defs/sha256" },
        "catalog_sha256": { "$ref": "#/$defs/sha256" },
        "catalog_revision": { "$ref": "#/$defs/id" },
        "class_ids_sha256": { "$ref": "#/$defs/sha256" },
        "class_count": { "type": "integer", "minimum": 2, "maximum": 4096 },
        "class_id": { "$ref": "#/$defs/id" },
        "class_index": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "canonical_label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "encoding": { "const": "one-hot-v1" },
        "open_text_accepted": { "const": false }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_sha256", "public_key_sha256", "package_id", "package_revision",
        "precision_profile", "package_license_spdx", "source_revision", "source_sha256",
        "source_license_spdx", "checkpoint_sha256", "checkpoint_license_spdx", "accelerator"
      ],
      "properties": {
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "public_key_sha256": { "$ref": "#/$defs/sha256" },
        "package_id": { "$ref": "#/$defs/id" },
        "package_revision": { "$ref": "#/$defs/id" },
        "precision_profile": { "$ref": "#/$defs/id" },
        "package_license_spdx": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source_revision": { "$ref": "#/$defs/id" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "source_license_spdx": { "type": "string", "minLength": 1, "maxLength": 512 },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_license_spdx": { "type": "string", "minLength": 1, "maxLength": 512 },
        "accelerator": { "enum": ["cpu", "metal", "cuda"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_signing_key_id", "causal_signing_key_id", "offline_model_package_sha256",
        "offline_evaluation_result_sha256", "causal_evaluation_result_sha256",
        "state_reset_flush_result_sha256", "snapshot_roundtrip_result_sha256",
        "recombination_result_sha256", "latency_result_sha256",
        "realtime_callback_result_sha256", "transition_result_sha256",
        "device_measurements", "strata", "accepted"
      ],
      "properties": {
        "offline_signing_key_id": { "$ref": "#/$defs/sha256" },
        "causal_signing_key_id": { "$ref": "#/$defs/sha256" },
        "offline_model_package_sha256": { "$ref": "#/$defs/sha256" },
        "offline_evaluation_result_sha256": { "$ref": "#/$defs/sha256" },
        "causal_evaluation_result_sha256": { "$ref": "#/$defs/sha256" },
        "state_reset_flush_result_sha256": { "$ref": "#/$defs/sha256" },
        "snapshot_roundtrip_result_sha256": { "$ref": "#/$defs/sha256" },
        "recombination_result_sha256": { "$ref": "#/$defs/sha256" },
        "latency_result_sha256": { "$ref": "#/$defs/sha256" },
        "realtime_callback_result_sha256": { "$ref": "#/$defs/sha256" },
        "transition_result_sha256": { "$ref": "#/$defs/sha256" },
        "device_measurements": { "type": "integer", "minimum": 3, "maximum": 64 },
        "strata": { "const": 14 },
        "accepted": { "const": true }
      }
    },
    "decision_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published_present_blocks", "fallback_absent_blocks", "fallback_uncertain_blocks",
        "fallback_present_warmup_blocks", "fallback_safety_gate_blocks",
        "fallback_flush_blocks", "fallback_overload_blocks"
      ],
      "properties": {
        "published_present_blocks": { "$ref": "#/$defs/counter" },
        "fallback_absent_blocks": { "$ref": "#/$defs/counter" },
        "fallback_uncertain_blocks": { "$ref": "#/$defs/counter" },
        "fallback_present_warmup_blocks": { "$ref": "#/$defs/counter" },
        "fallback_safety_gate_blocks": { "$ref": "#/$defs/counter" },
        "fallback_flush_blocks": { "$ref": "#/$defs/counter" },
        "fallback_overload_blocks": { "$ref": "#/$defs/counter" }
      }
    }
  }
}

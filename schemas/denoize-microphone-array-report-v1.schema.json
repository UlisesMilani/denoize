{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/schemas/denoize-microphone-array-report-v1.schema.json",
  "title": "denoize microphone-array enhancement report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "implementation",
    "configuration_sha256",
    "evidence_signing_key_id",
    "evidence_evaluation_result_sha256",
    "input_pcm_sha256",
    "output_pcm_sha256",
    "sample_rate",
    "input_channels",
    "input_frames",
    "output_channels",
    "output_frames",
    "reference_microphone_id",
    "canonical_microphone_ids",
    "active_microphones",
    "inactive_microphone_ids",
    "frame_size",
    "hop_size",
    "algorithmic_latency_milliseconds",
    "solved_frequency_bins",
    "fallback_frequency_bins",
    "maximum_observed_condition_number",
    "clipped_samples",
    "non_finite_samples",
    "exact_output_duration",
    "paths_recorded",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "denoize-microphone-array-report-v1" },
    "schema_version": { "const": 1 },
    "implementation": { "const": "native-wpe-mask-mvdr-v1" },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "evidence_signing_key_id": { "$ref": "#/$defs/sha256" },
    "evidence_evaluation_result_sha256": { "$ref": "#/$defs/sha256" },
    "input_pcm_sha256": { "$ref": "#/$defs/sha256" },
    "output_pcm_sha256": { "$ref": "#/$defs/sha256" },
    "sample_rate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
    "input_channels": { "type": "integer", "minimum": 2, "maximum": 4 },
    "input_frames": { "type": "integer", "minimum": 1, "maximum": 691200000 },
    "output_channels": { "const": 1 },
    "output_frames": { "type": "integer", "minimum": 1, "maximum": 691200000 },
    "reference_microphone_id": { "$ref": "#/$defs/id" },
    "canonical_microphone_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "active_microphones": { "type": "integer", "minimum": 1, "maximum": 4 },
    "inactive_microphone_ids": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "frame_size": { "type": "integer", "minimum": 128, "maximum": 4096 },
    "hop_size": { "type": "integer", "minimum": 1, "maximum": 2048 },
    "algorithmic_latency_milliseconds": { "type": "number", "minimum": 0, "maximum": 100 },
    "solved_frequency_bins": { "$ref": "#/$defs/count" },
    "fallback_frequency_bins": { "$ref": "#/$defs/count" },
    "maximum_observed_condition_number": { "type": "number", "minimum": 0, "maximum": 1000000000000 },
    "clipped_samples": { "$ref": "#/$defs/count" },
    "non_finite_samples": { "const": 0 },
    "exact_output_duration": { "const": true },
    "paths_recorded": { "const": 0 },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,256}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-project-v1.schema.json",
  "title": "denoize portable project v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "project_id", "denoize_version", "sources", "timelines", "settings", "presets", "models", "plans", "receipts"],
  "properties": {
    "schema": { "const": "denoize-project-v1" },
    "schema_version": { "const": 1 },
    "project_id": { "$ref": "#/$defs/identifier" },
    "denoize_version": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/source" }
    },
    "timelines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/timeline" }
    },
    "settings": { "$ref": "#/$defs/artifacts" },
    "presets": { "$ref": "#/$defs/artifacts" },
    "models": {
      "type": "array",
      "maxItems": 16384,
      "items": { "$ref": "#/$defs/model" }
    },
    "plans": { "$ref": "#/$defs/artifacts" },
    "receipts": { "$ref": "#/$defs/artifacts" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\.$)(?!\\.\\.$)[A-Za-z0-9._-]+$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\.\\.?(?:/|$))(?!.*[/]\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)[^/\\u0000-\\u001f\\u007f-\\u009f]{1,255}(?:/[^/\\u0000-\\u001f\\u007f-\\u009f]{1,255})*$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["len", "digest"],
      "properties": {
        "len": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locator", "fingerprint"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "locator": { "$ref": "#/$defs/locator" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 16384,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locator", "fingerprint", "timescale", "channels", "presentation_frames", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "locator": { "$ref": "#/$defs/locator" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "timescale": { "type": "integer", "minimum": 1, "maximum": 768000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 64 },
        "presentation_frames": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "license": {
          "oneOf": [
            { "$ref": "#/$defs/artifact" },
            { "type": "null" }
          ]
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "source", "timescale", "start_tick", "duration_ticks"],
      "properties": {
        "schema": { "const": "denoize-presentation-region-v1" },
        "schema_version": { "const": 1 },
        "source": { "$ref": "#/$defs/fingerprint" },
        "timescale": { "type": "integer", "minimum": 1, "maximum": 768000 },
        "start_tick": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "duration_ticks": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "region", "channel_map", "padding_before_ticks", "padding_after_ticks", "crossfade_from_previous_ticks"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/region" },
        "channel_map": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "integer", "minimum": 0, "maximum": 63 }
        },
        "padding_before_ticks": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "padding_after_ticks": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "crossfade_from_previous_ticks": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timescale", "channels", "selections"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "timescale": { "type": "integer", "minimum": 1, "maximum": 768000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 64 },
        "selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "items": { "$ref": "#/$defs/selection" }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "package", "public_key", "package_id", "package_revision", "signing_key_id", "license_spdx"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "package": { "$ref": "#/$defs/artifact" },
        "public_key": { "$ref": "#/$defs/artifact" },
        "package_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "package_revision": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "signing_key_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "license_spdx": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  }
}

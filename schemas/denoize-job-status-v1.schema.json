{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-job-status-v1.schema.json",
  "title": "denoize IPC durable job status v1",
  "$ref": "#/$defs/status",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "digest": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "u64": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nullableU64": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/u64" }] },
    "jobKind": { "enum": ["file", "batch", "stream"] },
    "jobState": {
      "enum": [
        "queued",
        "running",
        "pause-requested",
        "paused",
        "cancel-requested",
        "recovering",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["len", "digest"],
      "properties": {
        "len": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "job_id",
        "state",
        "kind",
        "priority",
        "queue_position",
        "submitted_at_unix_millis",
        "started_at_unix_millis",
        "finished_at_unix_millis",
        "attempt",
        "resumable",
        "plan_digest",
        "receipt",
        "error"
      ],
      "properties": {
        "schema": { "const": "denoize-job-status-v1" },
        "schema_version": { "const": 1 },
        "job_id": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/jobState" },
        "kind": { "$ref": "#/$defs/jobKind" },
        "priority": { "type": "integer", "minimum": -100, "maximum": 100 },
        "queue_position": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 4294967295 }
          ]
        },
        "submitted_at_unix_millis": { "$ref": "#/$defs/u64" },
        "started_at_unix_millis": { "$ref": "#/$defs/nullableU64" },
        "finished_at_unix_millis": { "$ref": "#/$defs/nullableU64" },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "resumable": { "type": "boolean" },
        "plan_digest": { "$ref": "#/$defs/digest" },
        "receipt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fingerprint" }]
        },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "file" } }, "required": ["kind"] },
          "then": { "properties": { "resumable": { "const": false } } },
          "else": { "properties": { "resumable": { "const": true } } }
        },
        {
          "if": {
            "properties": {
              "state": { "enum": ["completed", "failed", "cancelled"] }
            },
            "required": ["state"]
          },
          "then": { "properties": { "finished_at_unix_millis": { "$ref": "#/$defs/u64" } } },
          "else": { "properties": { "finished_at_unix_millis": { "type": "null" } } }
        }
      ]
    }
  }
}

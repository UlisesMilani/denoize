{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-update-manifest-v1.schema.json",
  "title": "denoize signed recoverable update manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "channel",
    "version",
    "sequence",
    "published_unix_seconds",
    "source_commit",
    "compatibility",
    "rollback_policy",
    "platforms"
  ],
  "properties": {
    "schema": { "const": "denoize-update-manifest-v1" },
    "schema_version": { "const": 1 },
    "channel": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/version" },
    "sequence": { "$ref": "#/$defs/sequence" },
    "published_unix_seconds": { "type": "integer", "minimum": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_from_versions",
        "minimum_state_schema_version",
        "maximum_state_schema_version"
      ],
      "properties": {
        "accepted_from_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/version" }
        },
        "minimum_state_schema_version": { "const": 1 },
        "maximum_state_schema_version": { "const": 1 }
      }
    },
    "rollback_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained_last_known_good",
        "health_timeout_seconds",
        "maximum_start_attempts",
        "manual_recovery",
        "network_required_for_recovery"
      ],
      "properties": {
        "retained_last_known_good": { "const": 1 },
        "health_timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 604800
        },
        "maximum_start_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "manual_recovery": { "const": true },
        "network_required_for_recovery": { "const": false }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/platform" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9._+-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9000999999999999
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\:\\u0000-\\u001F\\u007F-\\u009F]+$",
      "not": { "enum": [".", ".."] }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["len", "sha256"],
      "properties": {
        "len": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "fingerprint"],
      "properties": {
        "name": { "$ref": "#/$defs/filename" },
        "url": {
          "type": "string",
          "minLength": 9,
          "maxLength": 4096,
          "pattern": "^https://"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "activation": {
      "enum": [
        "portable-executable",
        "macos-app-archive",
        "app-image",
        "deb-package",
        "nsis-installer",
        "msi-installer"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sequence", "activation", "artifact", "sbom", "provenance"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "activation": { "$ref": "#/$defs/activation" },
        "artifact": { "$ref": "#/$defs/file" },
        "sbom": { "$ref": "#/$defs/file" },
        "provenance": { "$ref": "#/$defs/file" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_version", "from_sequence", "bundle_url", "payload"],
      "properties": {
        "from_version": { "$ref": "#/$defs/version" },
        "from_sequence": { "$ref": "#/$defs/sequence" },
        "bundle_url": {
          "type": "string",
          "minLength": 9,
          "maxLength": 4096,
          "pattern": "^https://"
        },
        "payload": { "$ref": "#/$defs/payload" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "candidate", "rollbacks"],
      "properties": {
        "platform": { "$ref": "#/$defs/identifier" },
        "candidate": { "$ref": "#/$defs/payload" },
        "rollbacks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/rollback" }
        }
      }
    }
  }
}

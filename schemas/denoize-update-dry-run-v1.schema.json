{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-update-dry-run-v1.schema.json",
  "title": "denoize read-only update dry-run report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "channel",
    "platform",
    "current_version",
    "candidate_version",
    "candidate_sequence",
    "manifest_sha256",
    "bundle_sha256",
    "decision",
    "reason_codes",
    "staging_bytes",
    "maximum_staging_bytes",
    "destination_actions",
    "preserves_last_known_good",
    "recovery_requires_network",
    "read_only"
  ],
  "properties": {
    "schema": { "const": "denoize-update-dry-run-v1" },
    "schema_version": { "const": 1 },
    "channel": { "$ref": "#/$defs/identifier" },
    "platform": { "$ref": "#/$defs/identifier" },
    "current_version": { "$ref": "#/$defs/version" },
    "candidate_version": { "$ref": "#/$defs/version" },
    "candidate_sequence": { "type": "integer", "minimum": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "bundle_sha256": { "$ref": "#/$defs/sha256" },
    "decision": { "enum": ["ready", "rejected"] },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "staging_bytes": { "type": "integer", "minimum": 1, "maximum": 5368709120 },
    "maximum_staging_bytes": { "type": "integer", "minimum": 1, "maximum": 5368709120 },
    "destination_actions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "stage-candidate-slot",
          "stage-last-known-good-slot",
          "atomically-activate-candidate",
          "retain-offline-recovery"
        ]
      }
    },
    "preserves_last_known_good": { "const": true },
    "recovery_requires_network": { "const": false },
    "read_only": { "const": true }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9._+-]{1,128}$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

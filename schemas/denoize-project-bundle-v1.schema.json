{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-project-bundle-v1.schema.json",
  "title": "denoize portable project bundle report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "project_id",
    "manifest_digest",
    "bundle",
    "manifest",
    "verification",
    "source_payloads_included",
    "source_payload_limit_bytes",
    "source_payload_bytes",
    "model_payloads_included",
    "model_payload_limit_bytes",
    "model_payload_bytes",
    "document_bytes",
    "files"
  ],
  "properties": {
    "schema": { "const": "denoize-project-bundle-v1" },
    "schema_version": { "const": 1 },
    "project_id": { "$ref": "#/$defs/id" },
    "manifest_digest": { "$ref": "#/$defs/digest" },
    "bundle": { "$ref": "#/$defs/fingerprint" },
    "manifest": { "$ref": "#/$defs/fingerprint" },
    "verification": { "$ref": "#/$defs/fingerprint" },
    "source_payloads_included": { "type": "boolean" },
    "source_payload_limit_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 68719476736
    },
    "source_payload_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 68719476736
    },
    "model_payloads_included": { "type": "boolean" },
    "model_payload_limit_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 68719476736
    },
    "model_payload_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 68719476736
    },
    "document_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    },
    "files": {
      "type": "array",
      "maxItems": 32768,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\.$)(?!\\.\\.$)[A-Za-z0-9._-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\.\\.?(?:/|$))(?!.*[/]\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)[^/\\u0000-\\u001f\\u007f-\\u009f]{1,255}(?:/[^/\\u0000-\\u001f\\u007f-\\u009f]{1,255})*$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["len", "digest"],
      "properties": {
        "len": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "source-license",
            "setting",
            "preset",
            "model-package",
            "model-public-key",
            "plan",
            "receipt"
          ]
        },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "fingerprint", "bindings"],
      "properties": {
        "locator": { "$ref": "#/$defs/locator" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32768,
          "items": { "$ref": "#/$defs/binding" }
        }
      }
    }
  }
}

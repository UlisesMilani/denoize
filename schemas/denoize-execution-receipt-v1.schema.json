{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-execution-receipt-v1.schema.json",
  "title": "denoize signed execution receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "payload", "signature"],
  "properties": {
    "schema": { "const": "denoize-execution-receipt-v1" },
    "schema_version": { "const": 1 },
    "payload": { "$ref": "#/$defs/payload" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\\\:\\u0000-\\u001F\\u007F-\\u009F])[^/]{1,255}(?:/[^/]{1,255})*$"
    },
    "executionKind": {
      "enum": ["file", "batch"]
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["len", "digest"],
      "properties": {
        "len": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fingerprint"],
      "properties": {
        "path": { "$ref": "#/$defs/locator" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "receiptOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "fingerprint"],
      "properties": {
        "path": { "$ref": "#/$defs/locator" },
        "format": { "$ref": "#/$defs/safeText" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "input",
        "output",
        "model",
        "recipe",
        "backend",
        "accelerator",
        "channels",
        "frames",
        "sample_rate",
        "outcome"
      ],
      "properties": {
        "item_id": { "$ref": "#/$defs/digest" },
        "input": { "$ref": "#/$defs/artifact" },
        "output": { "$ref": "#/$defs/receiptOutput" },
        "model": {
          "oneOf": [
            { "$ref": "#/$defs/artifact" },
            { "type": "null" }
          ]
        },
        "recipe": { "$ref": "#/$defs/digest" },
        "backend": { "$ref": "#/$defs/safeText" },
        "accelerator": { "$ref": "#/$defs/safeText" },
        "channels": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "frames": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sample_rate": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["succeeded", "skipped"] }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denoize_version", "kind", "plan_digest", "items"],
      "properties": {
        "denoize_version": { "$ref": "#/$defs/safeText" },
        "kind": { "$ref": "#/$defs/executionKind" },
        "plan_digest": { "$ref": "#/$defs/digest" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value_base64"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/keyId" },
        "value_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}

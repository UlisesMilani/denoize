{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-update-manifest-verification-v1.schema.json",
  "title": "denoize update manifest verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "channel",
    "version",
    "sequence",
    "manifest_sha256",
    "signing_key_id",
    "platform_count"
  ],
  "properties": {
    "schema": { "const": "denoize-update-manifest-verification-v1" },
    "schema_version": { "const": 1 },
    "channel": { "type": "string", "pattern": "^[a-z0-9._+-]{1,64}$" },
    "version": { "$ref": "#/$defs/version" },
    "sequence": { "type": "integer", "minimum": 0 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "signing_key_id": { "type": "string", "pattern": "^[0-9A-F]{16}$" },
    "platform_count": { "type": "integer", "minimum": 1, "maximum": 64 }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

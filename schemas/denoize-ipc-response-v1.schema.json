{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-ipc-response-v1.schema.json",
  "title": "denoize local IPC response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "request_id", "ok", "result", "error"],
  "properties": {
    "schema": { "const": "denoize-ipc-response-v1" },
    "schema_version": { "const": 1 },
    "request_id": { "$ref": "#/$defs/id" },
    "ok": { "type": "boolean" },
    "result": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/result" }]
    },
    "error": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }]
    }
  },
  "oneOf": [
    {
      "properties": {
        "ok": { "const": true },
        "result": { "$ref": "#/$defs/result" },
        "error": { "type": "null" }
      }
    },
    {
      "properties": {
        "ok": { "const": false },
        "result": { "type": "null" },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "u64": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000]+$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$" },
        "retryable": { "type": "boolean" }
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "pong" },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["server_time_unix_millis"],
              "properties": { "server_time_unix_millis": { "$ref": "#/$defs/u64" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "dry-run" },
            "value": { "$ref": "denoize-job-dry-run-v1.schema.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "submitted" },
            "value": { "$ref": "denoize-job-status-v1.schema.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "status" },
            "value": { "$ref": "denoize-job-status-v1.schema.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "jobs" },
            "value": {
              "type": "array",
              "maxItems": 10000,
              "items": { "$ref": "denoize-job-status-v1.schema.json" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "history" },
            "value": { "$ref": "denoize-job-history-v1.schema.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "grant" },
            "value": { "$ref": "denoize-ipc-capability-v1.schema.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "grants" },
            "value": {
              "type": "array",
              "maxItems": 10000,
              "items": { "$ref": "denoize-ipc-capability-summary-v1.schema.json" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "acknowledged" } }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-project-v2-provenance-v1.schema.json",
  "title": "denoize signed project v2 edit provenance",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "payload", "signature"],
  "properties": {
    "schema": { "const": "denoize-project-v2-provenance-v1" }, "schema_version": { "const": 1 },
    "payload": { "$ref": "#/$defs/payload" },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value_base64"], "properties": { "algorithm": { "const": "ed25519" }, "key_id": { "$ref": "denoize-project-v2.schema.json#/$defs/digest" }, "value_base64": { "type": "string", "minLength": 1, "maxLength": 1024 } } }
  },
  "$defs": {
    "ingredient": { "type": "object", "additionalProperties": false, "required": ["source_id", "fingerprint"], "properties": { "source_id": { "$ref": "denoize-project-v2.schema.json#/$defs/identifier" }, "fingerprint": { "$ref": "denoize-project-v2.schema.json#/$defs/fingerprint" } } },
    "action": { "type": "object", "additionalProperties": false, "required": ["action", "graph_id", "node_kind", "node_id", "node_revision", "node_digest", "affected_start", "affected_duration"], "properties": { "action": { "const": "c2pa.edited" }, "graph_id": { "$ref": "denoize-project-v2.schema.json#/$defs/identifier" }, "node_kind": { "enum": ["clip", "effect"] }, "node_id": { "$ref": "denoize-project-v2.schema.json#/$defs/identifier" }, "node_revision": { "$ref": "denoize-project-v2.schema.json#/$defs/revision" }, "node_digest": { "$ref": "denoize-project-v2.schema.json#/$defs/digest" }, "affected_start": { "$ref": "denoize-project-v2.schema.json#/$defs/time" }, "affected_duration": { "$ref": "denoize-project-v2.schema.json#/$defs/positiveTime" } } },
    "payload": { "type": "object", "additionalProperties": false, "required": ["schema", "schema_version", "c2pa_specification_target", "assertion_label", "manifest_digest", "project_id", "graph_id", "denoize_version", "ingredients", "actions", "models", "output_format", "output", "output_pcm_sha256", "carrier", "c2pa_manifest_store_embedded", "signer_disclosure_required"], "properties": {
      "schema": { "const": "denoize-project-v2-provenance-v1" }, "schema_version": { "const": 1 }, "c2pa_specification_target": { "const": "2.4" }, "assertion_label": { "const": "org.denoize.project-edit.v1" },
      "manifest_digest": { "$ref": "denoize-project-v2.schema.json#/$defs/digest" }, "project_id": { "$ref": "denoize-project-v2.schema.json#/$defs/identifier" }, "graph_id": { "$ref": "denoize-project-v2.schema.json#/$defs/identifier" }, "denoize_version": { "$ref": "denoize-project-v2.schema.json#/$defs/text" },
      "ingredients": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/ingredient" } }, "actions": { "type": "array", "minItems": 1, "maxItems": 400000, "items": { "$ref": "#/$defs/action" } }, "models": { "type": "array", "maxItems": 16384, "items": { "$ref": "denoize-project-v2-cache-request-v1.schema.json#/$defs/model" } },
      "output_format": { "enum": ["wav-float32", "wav-pcm24", "flac24", "ogg-opus", "mp3", "m4a"] }, "output": { "$ref": "denoize-project-v2.schema.json#/$defs/fingerprint" }, "output_pcm_sha256": { "$ref": "denoize-project-v2.schema.json#/$defs/digest" },
      "carrier": { "enum": ["detached-ogg-opus", "detached-generic"] }, "c2pa_manifest_store_embedded": { "const": false }, "signer_disclosure_required": { "const": true }
    } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-update-check-v1.schema.json",
  "title": "denoize read-only update check report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "channel",
    "platform",
    "current_version",
    "current_sequence",
    "candidate_version",
    "candidate_sequence",
    "manifest_sha256",
    "signing_key_id",
    "decision",
    "reason_codes",
    "bundle_url",
    "download_upper_bound_bytes",
    "read_only"
  ],
  "properties": {
    "schema": { "const": "denoize-update-check-v1" },
    "schema_version": { "const": 1 },
    "channel": { "$ref": "#/$defs/identifier" },
    "platform": { "$ref": "#/$defs/identifier" },
    "current_version": { "$ref": "#/$defs/version" },
    "current_sequence": { "type": "integer", "minimum": 0 },
    "candidate_version": { "$ref": "#/$defs/version" },
    "candidate_sequence": { "type": "integer", "minimum": 0 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "signing_key_id": { "type": "string", "pattern": "^[0-9A-F]{16}$" },
    "decision": {
      "enum": [
        "available",
        "current",
        "incompatible",
        "pending-health",
        "rollback-blocked",
        "equivocation"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "bundle_url": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 4096, "pattern": "^https://" }
      ]
    },
    "download_upper_bound_bytes": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1, "maximum": 5368709120 }
      ]
    },
    "read_only": { "const": true }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9._+-]{1,128}$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-execution-plan-v1.schema.json",
  "title": "denoize finite execution plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "denoize_version",
    "kind",
    "deterministic",
    "metadata_policy",
    "items"
  ],
  "properties": {
    "schema": { "const": "denoize-execution-plan-v1" },
    "schema_version": { "const": 1 },
    "denoize_version": { "$ref": "#/$defs/safeText" },
    "kind": { "$ref": "#/$defs/executionKind" },
    "deterministic": { "type": "boolean" },
    "metadata_policy": { "enum": ["preserve", "drop"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\\\:\\u0000-\\u001F\\u007F-\\u009F])[^/]{1,255}(?:/[^/]{1,255})*$"
    },
    "executionKind": {
      "enum": ["file", "batch"]
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["len", "digest"],
      "properties": {
        "len": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fingerprint"],
      "properties": {
        "path": { "$ref": "#/$defs/locator" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "publication",
        "action",
        "reason",
        "existing_fingerprint"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/locator" },
        "format": { "$ref": "#/$defs/safeText" },
        "publication": { "enum": ["no-clobber", "replace", "none"] },
        "action": { "enum": ["process", "skip"] },
        "reason": { "$ref": "#/$defs/safeText" },
        "existing_fingerprint": {
          "oneOf": [
            { "$ref": "#/$defs/fingerprint" },
            { "type": "null" }
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "gpu_jobs": { "const": 0 } } },
          "then": { "properties": { "gpu_memory_bytes": { "const": 0 } } },
          "else": { "properties": { "gpu_memory_bytes": { "minimum": 1 } } }
        }
      ],
      "required": [
        "memory_bytes",
        "temporary_bytes",
        "cpu_jobs",
        "gpu_jobs",
        "gpu_memory_bytes"
      ],
      "properties": {
        "memory_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "temporary_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cpu_jobs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "gpu_jobs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "gpu_memory_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "output": {
                "properties": { "action": { "const": "process" } }
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "publication": { "enum": ["no-clobber", "replace"] },
                  "existing_fingerprint": { "type": "null" }
                }
              },
              "resources": {
                "properties": {
                  "memory_bytes": { "minimum": 1 },
                  "temporary_bytes": { "minimum": 1 },
                  "cpu_jobs": { "minimum": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "output": {
                "properties": { "action": { "const": "skip" } }
              }
            }
          },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "publication": { "const": "none" },
                  "existing_fingerprint": { "$ref": "#/$defs/fingerprint" }
                }
              },
              "resources": {
                "properties": {
                  "memory_bytes": { "const": 0 },
                  "temporary_bytes": { "const": 0 },
                  "cpu_jobs": { "const": 0 },
                  "gpu_jobs": { "const": 0 },
                  "gpu_memory_bytes": { "const": 0 }
                }
              }
            }
          }
        }
      ],
      "required": [
        "item_id",
        "input",
        "output",
        "model",
        "recipe",
        "backend",
        "accelerator",
        "input_format",
        "input_codec",
        "channels",
        "frames",
        "sample_rate",
        "resources"
      ],
      "properties": {
        "item_id": { "$ref": "#/$defs/digest" },
        "input": { "$ref": "#/$defs/artifact" },
        "output": { "$ref": "#/$defs/output" },
        "model": {
          "oneOf": [
            { "$ref": "#/$defs/artifact" },
            { "type": "null" }
          ]
        },
        "recipe": { "$ref": "#/$defs/digest" },
        "backend": { "$ref": "#/$defs/safeText" },
        "accelerator": { "$ref": "#/$defs/safeText" },
        "input_format": { "$ref": "#/$defs/safeText" },
        "input_codec": { "$ref": "#/$defs/safeText" },
        "channels": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "frames": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sample_rate": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/$defs/resources" }
      }
    }
  }
}

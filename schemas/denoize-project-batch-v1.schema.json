{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-project-batch-v1.schema.json",
  "title": "denoize deterministic project batch report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "items"],
  "properties": {
    "schema": { "const": "denoize-project-batch-v1" },
    "schema_version": { "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\.$)(?!\\.\\.$)[A-Za-z0-9._-]+$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\.\\.?(?:/|$))(?!.*[/]\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)[^/\\u0000-\\u001f\\u007f-\\u009f]{1,255}(?:/[^/\\u0000-\\u001f\\u007f-\\u009f]{1,255})*$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["len", "digest"],
      "properties": {
        "len": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "project_id",
        "manifest_digest",
        "timeline_id",
        "timeline_digest",
        "output",
        "timescale",
        "channels",
        "presentation_frames",
        "retained_pcm_upper_bound_bytes"
      ],
      "properties": {
        "schema": { "const": "denoize-project-render-v1" },
        "schema_version": { "const": 1 },
        "project_id": { "$ref": "#/$defs/id" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "timeline_id": { "$ref": "#/$defs/id" },
        "timeline_digest": { "$ref": "#/$defs/digest" },
        "output": { "$ref": "#/$defs/fingerprint" },
        "timescale": { "type": "integer", "minimum": 1, "maximum": 768000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 64 },
        "presentation_frames": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "retained_pcm_upper_bound_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "manifest_digest",
        "manifest_locator",
        "timeline_id",
        "output_locator",
        "render"
      ],
      "properties": {
        "project_id": { "$ref": "#/$defs/id" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "manifest_locator": { "$ref": "#/$defs/locator" },
        "timeline_id": { "$ref": "#/$defs/id" },
        "output_locator": { "$ref": "#/$defs/locator" },
        "render": { "$ref": "#/$defs/render" }
      }
    }
  }
}

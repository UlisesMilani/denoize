{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/blob/main/schemas/denoize-presentation-region-v1.schema.json",
  "title": "denoize presentation region v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "source", "timescale", "start_tick", "duration_ticks"],
  "properties": {
    "schema": { "const": "denoize-presentation-region-v1" },
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["len", "digest"],
      "properties": {
        "len": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "timescale": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "start_tick": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "duration_ticks": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  }
}

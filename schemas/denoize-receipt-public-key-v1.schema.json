{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-receipt-public-key-v1.schema.json",
  "title": "denoize receipt public key v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "algorithm",
    "key_id",
    "public_key_base64"
  ],
  "properties": {
    "schema": { "const": "denoize-receipt-public-key-v1" },
    "schema_version": { "const": 1 },
    "algorithm": { "const": "ed25519" },
    "key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_key_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    }
  }
}

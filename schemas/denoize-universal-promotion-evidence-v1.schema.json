{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/schemas/denoize-universal-promotion-evidence-v1.schema.json",
  "title": "denoize signed universal restoration promotion evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "payload", "signature"],
  "properties": {
    "schema": { "const": "denoize-universal-promotion-evidence-v1" },
    "schema_version": { "const": 1 },
    "payload": { "$ref": "#/$defs/payload" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9._+-]{1,256}$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_at_unix_seconds",
        "model_package_sha256",
        "model_family",
        "source_revision",
        "source_sha256",
        "checkpoint_sha256",
        "corpus_manifest_sha256",
        "evaluation_result_sha256",
        "strata",
        "minimum_listeners",
        "listener_count",
        "listener_preference",
        "listener_preference_limit",
        "accepted"
      ],
      "properties": {
        "completed_at_unix_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_package_sha256": { "$ref": "#/$defs/sha256" },
        "model_family": { "enum": ["discriminative", "hybrid", "generative"] },
        "source_revision": { "$ref": "#/$defs/id" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "evaluation_result_sha256": { "$ref": "#/$defs/sha256" },
        "strata": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stratum" }
        },
        "minimum_listeners": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "listener_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "listener_preference": { "type": "number", "minimum": 0, "maximum": 1 },
        "listener_preference_limit": { "type": "number", "minimum": 0, "maximum": 1 },
        "accepted": { "type": "boolean" }
      }
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cases", "metrics"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "cases": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/metric" }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "operator", "limit", "passed"],
      "properties": {
        "metric": { "$ref": "#/$defs/id" },
        "value": { "type": "number" },
        "operator": { "enum": ["greater-or-equal", "less-or-equal"] },
        "limit": { "type": "number" },
        "passed": { "type": "boolean" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value_base64"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/sha256" },
        "value_base64": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
